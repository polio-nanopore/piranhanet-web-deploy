# Redirect HTTP to HTTPS
server {
    listen 80;

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /tls/certificate.pem;
    ssl_certificate_key /tls/key.pem;

    client_max_body_size 100M;

    # Do not buffer streaming responses or uploads
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_http_version 1.1;

    location /api/ {
        proxy_pass http://piranhanet-api:8000/;
    }

    location / {
        proxy_pass http://piranhanet-web:5173;
    }
}
